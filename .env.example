# PacketScope Environment Configuration
PROJECT_NAME=PacketScope
ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=packetscope-defensive-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# File Storage
UPLOAD_DIR=./backend/uploads
DATA_DIR=./backend/data
SQLITE_DB_PATH=./backend/data/packetscope.db
MAX_UPLOAD_SIZE_MB=50

# TShark Binary Path (Auto-detected if empty, e.g. /usr/bin/tshark or C:\Program Files\Wireshark\tshark.exe)
TSHARK_PATH=

# Detection Engine Configurable Thresholds
PORT_SCAN_PORT_THRESHOLD=15
PORT_SCAN_WINDOW_SECONDS=10.0
CONNECTION_BURST_COUNT=50
CONNECTION_BURST_WINDOW_SECONDS=5.0
SYN_BURST_THRESHOLD=20
SYN_TO_FIN_RATIO=3.0
ICMP_FLOOD_PACKET_THRESHOLD=30
ICMP_FLOOD_WINDOW_SECONDS=5.0
LARGE_DNS_QUERY_LENGTH=60
TRAFFIC_CONCENTRATION_THRESHOLD=0.60
MONITORED_PORTS=21,23,69,4444,1337,31337,6667,5555
